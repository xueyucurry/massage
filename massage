flag_enabled() {
  case "${1,,}" in
    1|true|yes|on)
      return 0
      ;;
    *)
      return 1
      ;;
  esac
}

is_wsl() {
  [[ -n "${WSL_DISTRO_NAME:-}" ]] \
    || grep -qi microsoft /proc/sys/kernel/osrelease 2>/dev/null
}

realsense_attached() {
  command -v lsusb >/dev/null 2>&1 \
    && lsusb 2>/dev/null \
      | grep -qi "ID ${REALSENSE_USB_HARDWARE_ID:-8086:0b3a}"
}

ensure_realsense_attached() {
  local hardware_id="${REALSENSE_USB_HARDWARE_ID:-8086:0b3a}"
  local auto_attach="${MASSAGE_REALSENSE_AUTO_ATTACH:-1}"
  local required="${MASSAGE_REALSENSE_REQUIRED:-1}"
  local attach_output=""
  local attach_rc=0
  local attempts=32
  local i

  if realsense_attached; then
    echo "RealSense 已连接 (${hardware_id})。"
    return 0
  fi

  echo "当前 Linux 环境未检测到 RealSense (${hardware_id})。" >&2
  if is_wsl && flag_enabled "${auto_attach}"; then
    if command -v usbipd.exe >/dev/null 2>&1; then
      echo "正在通过 usbipd 自动挂载 RealSense..."
      attach_output="$(
        usbipd.exe attach --wsl --hardware-id "${hardware_id}" 2>&1
      )" || attach_rc=$?
      if [[ -n "${attach_output}" ]]; then
        printf '%s\n' "${attach_output}" | tr -d '\r'
      fi

      for ((i = 0; i < attempts; i++)); do
        if realsense_attached; then
          echo "RealSense 自动挂载成功。"
          return 0
        fi
        sleep 0.25
      done
    else
      attach_rc=127
      echo "WSL 无法调用 usbipd.exe，不能自动挂载相机。" >&2
    fi
  elif is_wsl; then
    echo "RealSense 自动挂载已关闭。" >&2
  fi

  if is_wsl; then
    echo "RealSense 挂载失败 (usbipd exit=${attach_rc})。" >&2
    echo "请确认相机已插入，并在 Windows 管理员 PowerShell 执行：" >&2
    echo "  usbipd bind --hardware-id ${hardware_id}" >&2
    echo "然后重新运行 ./massage；普通 attach 将由启动脚本自动完成。" >&2
  else
    echo "请确认相机已直接连接到本机 USB 3.x 端口，并执行以下命令核对：" >&2
    echo "  lsusb -d ${hardware_id}" >&2
    echo "若设备可见但程序无法访问，请检查 RealSense udev 规则和当前用户权限。" >&2
  fi

  if flag_enabled "${required}"; then
    return 1
  fi
  echo "MASSAGE_REALSENSE_REQUIRED=0，忽略相机缺失并继续。" >&2
  return 0
}

setup_ros_env() {
  if [[ ! -f /opt/ros/humble/setup.bash ]]; then
    echo "找不到 ROS2 Humble 环境: /opt/ros/humble/setup.bash" >&2
    exit 1
  fi
  if [[ ! -f "${ROS2_WS}/install/setup.bash" ]]; then
    echo "找不到 FAIRINO ROS2 install 环境: ${ROS2_WS}/install/setup.bash" >&2
    echo "请先在 ${ROS2_WS} 中执行: source /opt/ros/humble/setup.bash && PYTHONNOUSERSITE=1 colcon build --symlink-install" >&2
    exit 1
  fi

  set +u
  source /opt/ros/humble/setup.bash
  source "${ROS2_WS}/install/setup.bash"
  set -u

  mkdir -p "${RUNTIME_LIB_DIR}"
  local runtime_lib_candidate
  local runtime_lib_candidates=(
    "${FAIRINO_RUNTIME_LIB:-}"
    "${ROS2_WS}/install/fairino_hardware/lib/libfairino.so.2.2.3"
    "${ROS2_WS}/install/fairino_hardware/lib/libfairino.so.2"
    "${ROS2_WS}/fairino_hardware/libfairino/lib/libfairino.so.2.2.3"
    "${ROS2_WS}/fairino_hardware/libfairino/lib/libfairino.so.2"
  )
  FAIRINO_RUNTIME_LIB=""
  for runtime_lib_candidate in "${runtime_lib_candidates[@]}"; do
    if [[ -n "${runtime_lib_candidate}" && -f "${runtime_lib_candidate}" ]]; then
      FAIRINO_RUNTIME_LIB="${runtime_lib_candidate}"
      break
    fi
  done
  if [[ ! -f "${FAIRINO_RUNTIME_LIB}" ]]; then
    echo "未找到 FAIRINO 运行库 libfairino.so" >&2
    exit 1
  fi

  ln -sf "${FAIRINO_RUNTIME_LIB}" "${RUNTIME_LIB_DIR}/libfairino.so.2"
  ln -sf "${FAIRINO_RUNTIME_LIB}" "${RUNTIME_LIB_DIR}/libfairino.so"
  export LD_LIBRARY_PATH="${RUNTIME_LIB_DIR}:${ROS2_WS}/install/fairino_hardware/lib:${ROS2_WS}/install/fairino_msgs/lib:${LD_LIBRARY_PATH:-}"

  if [[ -x "${FAIRINO_DIR}/.venv/bin/python" ]]; then
    PYTHON_BIN="${FAIRINO_DIR}/.venv/bin/python"
  elif [[ -x "${ROOT_DIR}/env/.venv/bin/python" ]]; then
    PYTHON_BIN="${ROOT_DIR}/env/.venv/bin/python"
  else
    PYTHON_BIN="python3"
  fi
  export PYTHON_BIN
}


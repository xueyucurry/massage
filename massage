reset_xiaozhi_agent_state() {
  local reset_source="${1:-massage gui startup cleanup}"
  local reset_message="${2:-就绪，等待语音指令}"
  local force_reset="${3:-0}"
  local reset_status="${4:-idle}"
  local python_bin="python3"
  if [[ -x "${XIAOZHI_PYTHON}" ]]; then
    python_bin="${XIAOZHI_PYTHON}"
  fi

  FT_AGENT_STATE_FILE="${FT_AGENT_STATE_FILE}" \
  FT_AGENT_CONTROL_FILE="${FT_AGENT_CONTROL_FILE}" \
  FT_AGENT_RESET_SOURCE="${reset_source}" \
  FT_AGENT_RESET_MESSAGE="${reset_message}" \
  FT_AGENT_FORCE_RESET="${force_reset}" \
  FT_AGENT_RESET_STATUS="${reset_status}" \
  "${python_bin}" - <<'PY'
import json
import os
import time
from pathlib import Path

state_path = Path(os.environ["FT_AGENT_STATE_FILE"])
control_path = Path(os.environ["FT_AGENT_CONTROL_FILE"])
reset_source = os.environ.get("FT_AGENT_RESET_SOURCE", "massage gui startup cleanup")
reset_message = os.environ.get("FT_AGENT_RESET_MESSAGE", "就绪，等待语音指令")
force_reset = os.environ.get("FT_AGENT_FORCE_RESET", "0").strip().lower() in {"1", "true", "yes", "on"}
reset_status = os.environ.get("FT_AGENT_RESET_STATUS", "idle").strip().lower() or "idle"
if reset_status == "ready":
    reset_status = "idle"
if reset_status not in {"idle", "stopped"}:
    reset_status = "idle"
now = time.strftime("%Y-%m-%d %H:%M:%S")

def read_json(path):
    if not path.exists():
        return {}
    try:
        with path.open("r", encoding="utf-8") as f:
            return json.load(f)
    except Exception:
        return {}

def write_json(path, data):
    path.parent.mkdir(parents=True, exist_ok=True)
    tmp_path = path.with_suffix(path.suffix + ".tmp")
    with tmp_path.open("w", encoding="utf-8") as f:
        json.dump(data, f, ensure_ascii=False, indent=2)
    tmp_path.replace(path)

state = read_json(state_path)
session_id = state.get("session_id")
write_json(
    control_path,
    {
        "session_id": session_id,
        "request": "stop",
        "updated_at": now,
        "source": reset_source,
    },
)

stale_statuses = {"detecting", "running", "pausing", "paused", "stopping"}
if state or reset_status == "idle":
    if not state:
        state = {}
    should_reset = force_reset or reset_status == "idle" or state.get("status") in stale_statuses
    if should_reset:
        state["status"] = reset_status
        state["message"] = reset_message
        if reset_status == "idle":
            state["session_id"] = None
            state["target"] = None
            state["target_label"] = None
            state["trajectory_path"] = None
            state["point_count"] = 0
            state["actions"] = []
        state["current_action"] = None
        state["stage"] = None
        state["current_point_index"] = 0
        state["current_repeat_index"] = 0
        state["current_step_index"] = 0
        state["resume_stage"] = None
        state["resume_point_index"] = 0
        state["resume_action"] = None
        state["resume_repeat_index"] = 0
        state["resume_step_index"] = 0
        state["worker_pid"] = None
        state["worker_alive"] = False
        state["updated_at"] = now
        write_json(state_path, state)
PY
}


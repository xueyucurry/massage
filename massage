    return 1
  fi
  if [[ ! -x "${XIAOZHI_PYTHON}" ]]; then
    echo "找不到小智 Python 环境: ${XIAOZHI_PYTHON}" >&2
    return 1
  fi
  if [[ ! -f "${XIAOZHI_DIR}/main.py" ]]; then
    echo "找不到小智入口: ${XIAOZHI_DIR}/main.py" >&2
    return 1
  fi

  if ! ensure_realsense_attached; then
    echo "GUI 启动：RealSense 未就绪，停止启动，机械臂服务尚未重启。" >&2
    return 1
  fi

  if ! cleanup_xiaozhi_gui_startup; then
    echo "GUI 启动清理失败，停止启动，避免重复占用相机。" >&2
    return 1
  fi
  setup_ros_env
  if ! restart_server_for_gui; then
    echo "GUI 启动：ROS2 控制服务重启失败，停止启动小智 GUI。" >&2
    return 1
  fi

  if home_pose_enabled "${MASSAGE_HOME_ON_GUI_START}"; then
    start_moveit
    if ! move_to_recorded_home "gui 启动回位"; then
      echo "gui 启动回位失败，停止启动小智 GUI。" >&2
      return 1
    fi
  fi

  if is_wsl; then
    export QT_QPA_PLATFORM="${XIAOZHI_QT_QPA_PLATFORM:-xcb}"
    export QT_SCALE_FACTOR="${XIAOZHI_QT_SCALE_FACTOR:-1.5}"
    export QT_IM_MODULE="${XIAOZHI_QT_IM_MODULE:-fcitx}"
    export GTK_IM_MODULE="${XIAOZHI_GTK_IM_MODULE:-fcitx}"
    export XMODIFIERS="${XIAOZHI_XMODIFIERS:-@im=fcitx}"
    if command -v fcitx5 >/dev/null 2>&1 && command -v dbus-launch >/dev/null 2>&1; then
      local qt_plugin_root="${HOME}/.local/lib/massage-qt5/plugins"
      local fcitx_qt_plugin=""
      fcitx_qt_plugin="$(
        dpkg-query -L fcitx5-frontend-qt5 2>/dev/null \
          | grep -m1 '/libfcitx5platforminputcontextplugin.so$' \
          || true
      )"
      if [[ -n "${fcitx_qt_plugin}" ]]; then
        mkdir -p "${qt_plugin_root}/platforminputcontexts"
        ln -sfn "${fcitx_qt_plugin}" \
          "${qt_plugin_root}/platforminputcontexts/libfcitx5platforminputcontextplugin.so"
        export QT_PLUGIN_PATH="${XIAOZHI_QT_PLUGIN_PATH:-${qt_plugin_root}}"
      fi

      local input_runtime_dir="${XDG_RUNTIME_DIR:-/tmp}"
      local dbus_env_file="${input_runtime_dir}/massage-dbus-session.env"
      mkdir -p "${input_runtime_dir}"

      if [[ -r "${dbus_env_file}" ]]; then
        # shellcheck disable=SC1090
        source "${dbus_env_file}"
      fi
      if ! dbus-send --session --dest=org.freedesktop.DBus \
        --type=method_call --print-reply / org.freedesktop.DBus.ListNames \
        >/dev/null 2>&1; then
        eval "$(dbus-launch --sh-syntax)"
        umask 077
        {
          printf 'export DBUS_SESSION_BUS_ADDRESS=%q\n' "${DBUS_SESSION_BUS_ADDRESS}"
          printf 'export DBUS_SESSION_BUS_PID=%q\n' "${DBUS_SESSION_BUS_PID:-}"
        } >"${dbus_env_file}"
      fi

      fcitx5 -d -r --keep >"${input_runtime_dir}/massage-fcitx5.log" 2>&1 || true
      sleep 0.3
      fcitx5-remote -r >/dev/null 2>&1 || true
      fcitx5-remote -s pinyin >/dev/null 2>&1 || true
    fi
  fi

  cd "${XIAOZHI_DIR}"
  export XIAOZHI_PUSH_TO_TALK_ONLY="${XIAOZHI_PUSH_TO_TALK_ONLY:-1}"
  export XIAOZHI_MASSAGE_ONLY="${XIAOZHI_MASSAGE_ONLY:-1}"
  exec "${XIAOZHI_PYTHON}" main.py --mode gui "$@"
}

run_calibration() {
  if [[ ! -f "${CALIBRATION_SCRIPT}" ]]; then
    echo "找不到标定程序: ${CALIBRATION_SCRIPT}" >&2
    return 1
  fi
  if [[ ! -x "${CALIBRATION_PYTHON}" ]]; then
    echo "找不到标定 Python 环境: ${CALIBRATION_PYTHON}" >&2
    return 1
  fi

  if ! ensure_realsense_attached; then
    echo "标定启动：RealSense 未就绪。" >&2
    return 1
  fi

  echo "启动相机到机械臂标定程序..."
  echo "标定目录: ${CALIBRATION_DIR}"
  echo "标定程序: ${CALIBRATION_SCRIPT}"
  echo "Python: ${CALIBRATION_PYTHON}"
  echo "机器人 IP: ${ROBOT_IP}"
  echo "标定结果将保存到: ${CALIBRATION_DIR}/camera_to_robot.json"

  cd "${CALIBRATION_DIR}"
  export PYTHONUNBUFFERED=1
  export PYTHONPATH="${FAIRINO_DIR}:${ROOT_DIR}/shared/vision:${PYTHONPATH:-}"
  exec "${CALIBRATION_PYTHON}" "${CALIBRATION_SCRIPT}" "$@"
}

run_back_line_adjuster() {
  if [[ ! -f "${BACK_LINE_ADJUSTER}" ]]; then
    echo "找不到膀胱经线偏移调节程序: ${BACK_LINE_ADJUSTER}" >&2
    return 1
  fi

  if ! ensure_realsense_attached; then
    echo "偏移调节启动：RealSense 未就绪。" >&2
    return 1
  fi

  setup_ros_env
  echo "启动四条膀胱经线偏移调节画面..."
  echo "该工具只使用相机，不会连接或移动机械臂。"
  cd "${FAIRINO_DIR}"
  export PYTHONUNBUFFERED=1
  export PYTHONPATH="${FAIRINO_DIR}:${ROOT_DIR}/shared/vision:${PYTHONPATH:-}"
  exec "${PYTHON_BIN}" "${BACK_LINE_ADJUSTER}" "$@"
}

run_force_monitor() {
  local monitor_script="${FAIRINO_DIR}/force_monitor_gui.py"
  if [[ ! -f "${monitor_script}" ]]; then
    echo "找不到力传感器监视程序: ${monitor_script}" >&2
    return 1
  fi
  if [[ ! -x "${XIAOZHI_PYTHON}" ]]; then
    echo "找不到包含 PyQt5 的 Python 环境: ${XIAOZHI_PYTHON}" >&2
    return 1
  fi

  setup_ros_env
  echo "启动只读力传感器监视窗口..."
  echo "接收 ft.py 已校验的力传感器读数。"
  echo "该窗口不会发送 ROS2、机械臂或力控命令。"
  exec "${XIAOZHI_PYTHON}" "${monitor_script}" "$@"
}

main() {
  local cmd="${1:-help}"
  if [[ "$#" -gt 0 ]]; then
    shift
  fi
  case "${cmd}" in
    start)
      if ! ensure_realsense_attached; then
        echo "按摩程序启动：RealSense 未就绪，机械臂服务尚未启动。" >&2
        exit 1
      fi
      start_stack
      if home_pose_enabled "${MASSAGE_HOME_ON_START}"; then
        move_to_recorded_home "start 回位"
      fi
      run_ft "$@"
      ;;
    restart)
      setup_ros_env
      stop_processes
      start_stack
      ;;
    stop)
      setup_ros_env
      stop_processes
      ;;
    clean)
      clean_residual_processes
      ;;
    gui)
      run_xiaozhi_gui "$@"
      ;;
    force-monitor)
      run_force_monitor "$@"
      ;;
    calibrate)
      run_calibration "$@"
      ;;
    adjust-lines)
      run_back_line_adjuster "$@"
      ;;
    camera-check)
      ensure_realsense_attached
      ;;
    record-home)
      setup_ros_env
      if ! service_ready; then
        start_server
        if ! probe_with_retries; then
          echo "ROS2 控制服务探针失败，无法记录回位姿态。" >&2
          exit 1
        fi
      fi
      record_home_pose
      ;;
    home)
      setup_ros_env
      if ! service_ready; then
        start_server
        if ! probe_with_retries; then
          echo "ROS2 控制服务探针失败，无法执行回位。" >&2
          exit 1
        fi
      fi
      move_to_recorded_home "手动回位"
      ;;
    help|-h|--help)
      usage
      ;;
    *)
      echo "未知命令: ${cmd}" >&2
      usage >&2
      exit 2
      ;;
  esac
}

main "$@"

start_stack() {
  setup_ros_env
  reset_ros2_discovery

  if server_process_exists; then
    if ! server_process_uses_installed_binary; then
      if pgrep -f "${RUNNER_PATTERN}" >/dev/null 2>&1; then
        echo "控制服务二进制已更新，但 ft.py 仍在运行；拒绝中途切换控制服务。" >&2
        echo "请先正常结束当前按摩流程，再重新执行 ./massage start。" >&2
        return 1
      fi
      echo "检测到控制服务仍在运行旧二进制，重启后台服务以加载新版本"
      stop_background_services
      setup_ros_env
    else
      echo "检测到已有 FAIRINO ROS2 控制服务，先执行探针"
      if probe_service; then
        echo "服务已运行并通过探针。"
        return 0
      fi
      echo "已有服务未通过探针，准备重启"
      stop_processes
      setup_ros_env
    fi
  elif service_ready; then
    echo "检测到残留 ROS2 服务发现信息，准备重新拉起控制服务"
    reset_ros2_discovery
  fi

  start_server
  if ! probe_with_retries; then
    echo "ROS2 控制服务探针失败，日志如下："
    tail -n 100 "${ROS2_LOG}" || true
    return 1
  fi

  echo "按摩后台服务已启动。"
  echo "日志: ${ROS2_LOG}"

  start_moveit
  echo "MoveIt 日志: ${MOVEIT_LOG}"
}

